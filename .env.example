VITE_API_BASE_URL=http://127.0.0.1:8000/api/content-engine
VITE_AUTH_API_BASE_URL=http://127.0.0.1:8000/api/auth
VITE_SESSION_TIMEOUT_MS=1800000

# Billing: /app/plans, /app/billing/demo (simulasi bayar jika backend BILLING_DEMO_PAYMENT_ENABLED=true)

# Google reCAPTCHA v3 site key (pair with backend RECAPTCHA_SECRET_KEY). Used for /register and /login token if set.
# VITE_RECAPTCHA_SITE_KEY=

# Required for Admin "Ingest Materi" — same value as backend OPENCLAW_API_KEY or an active DB IngestAPIKey.
VITE_INGEST_API_KEY=

# Optional: default language filter for learner module APIs (e.g. en, id). Leave empty for no filter.
# Learning page can override per browser via localStorage (see README / multilingual pilot doc).
VITE_LEARNER_LANGUAGE=